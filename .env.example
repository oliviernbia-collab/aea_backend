PORT=4000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=db_aea
JWT_SECRET=change_this_secret_before_production
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Agregateur de paiement Jeko (https://business.jeko.africa/settings/api)
# A remplir avec les cles du Dashboard Business > Parametres > API & Webhooks.
# Tant que JEKO_API_KEY / JEKO_API_KEY_ID / JEKO_STORE_ID sont vides, le paiement en ligne
# repond 503 cote API (voir services/jeko.js) sans bloquer le reste de l'application.
JEKO_BASE_URL=https://api.jeko.africa
JEKO_API_KEY=
JEKO_API_KEY_ID=
JEKO_STORE_ID=
JEKO_WEBHOOK_SECRET=
FRONTEND_URL=http://localhost:5173
# URL publique du backend (tunnel ngrok en dev, domaine reel en prod) : requise par Jeko pour
# successUrl/errorUrl, qui refuse localhost. Voir GET /api/paiement-retour dans app.js.
PUBLIC_BACKEND_URL=
